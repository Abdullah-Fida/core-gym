# Batgos WhatsApp worker
#
# Deploy as its own long-lived process (Railway / Render / Fly / VPS).
# Do NOT deploy on Vercel: Baileys holds a persistent socket that a serverless
# runtime freezes between invocations, forcing a QR re-scan on every cold start.

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Shared secret between the API and this worker. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# The same value must be set as WA_WORKER_TOKEN in backend/.env
WA_WORKER_TOKEN=

PORT=4100
LOG_LEVEL=warn

# Randomised gap between sends, in milliseconds. WhatsApp bans numbers that
# send on a mechanical cadence; do not set these to 0.
WA_MIN_DELAY_MS=3000
WA_MAX_DELAY_MS=9000
